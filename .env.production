# pnpm build / pnpm start — committed on purpose: no secrets. Secrets (REVALIDATE_SECRET,
# …) go to the host's env settings or .env.local. Full list: .env.example.

# Your public origin — canonical URLs, hreflang, sitemap, OG images.
NEXT_PUBLIC_CLIENT_URL=https://next-template-demo.vercel.app

# External backend base (requests go to <url>/api). Empty = own Route Handlers only.
NEXT_PUBLIC_SERVER_URL=
