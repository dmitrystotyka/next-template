{
  "name": "next-template",
  "description": "Production-ready Next.js 16 starter: TypeScript, Tailwind CSS v4, i18n, per-request CSP, strict gates — clean from the first commit",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "author": "Dmitry Stotyka (https://dmitrystotyka.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmitrystotyka/next-template.git"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.16"
  },
  "scripts": {
    "prepare": "node .template/setup/prepare.mjs",
    "dev": "next dev",
    "build": "next build && node .template/checks/check-public-env.mjs NEXT_PUBLIC_VITALS_ENDPOINT",
    "start": "next start",
    "preview": "pnpm build && pnpm start",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ --max-warnings 0 && stylelint \"src/**/*.css\" --cache --cache-strategy content --cache-location node_modules/.cache/stylelint/ --max-warnings 0",
    "fix": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ --fix && stylelint \"src/**/*.css\" --cache --cache-strategy content --cache-location node_modules/.cache/stylelint/ --fix && prettier --write . --cache --cache-location node_modules/.cache/prettier/.prettier-cache",
    "typecheck": "next typegen && tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && prettier --check . --cache --cache-location node_modules/.cache/prettier/.prettier-cache && pnpm typecheck && pnpm test:coverage && pnpm check:i18n && knip",
    "check:i18n": "node .template/checks/check-translations.mjs",
    "check:runtime": "node .template/checks/check-runtime.mjs",
    "page": "node .template/setup/page.mjs",
    "component": "node .template/setup/component.mjs",
    "api": "node .template/setup/api.mjs",
    "locale": "node .template/setup/locale.mjs",
    "clean": "node .template/setup/clean.mjs",
    "analyze": "next experimental-analyze"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@next/env": "16.3.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "html-validate": "^11.18.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
