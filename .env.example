# ──────────────────────────────────────────────────────────────────────────────
# Environment variables template.
# `.env.development` / `.env.production` are committed defaults (no secrets).
# Real values and secrets go to `.env.local` (gitignored, wins over both).
# ──────────────────────────────────────────────────────────────────────────────

# NOTE: PORT cannot live in .env files — Next picks the port from the shell
# before loading them. Use `pnpm dev -p 3100` (works in every shell).

# Public URL of the client app (used for metadataBase, sitemap, canonical, OG)
# Required. Must be an absolute URL including protocol.
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

# External backend base URL — `request()` (client) and `serverFetch` (server) call <url>/api.
# Leave empty if the app has no external API yet.
NEXT_PUBLIC_SERVER_URL=

# ── Optional: CSP report-only rollout ─────────────────────────────────────────
# When `true`, the CSP is sent as Content-Security-Policy-Report-Only —
# violations are reported (see CSP_REPORT_URI) but nothing is blocked.
# CSP_REPORT_ONLY=false

# ── Optional: CSP violation reports ───────────────────────────────────────────
# CSP_REPORT_URI=

# ── Optional: Trusted Types rollout ───────────────────────────────────────────
# 'off' (default) | 'report' | 'enforce' — see src/proxy.ts
# TRUSTED_TYPES_MODE=off

# ── Optional: rate limit bypass ───────────────────────────────────────────────
# Comma-separated IPs (monitoring, internal cron). Matched against the resolved
# identity — which exists only with TRUSTED_PROXY_HOPS set (or in dev).
# RATE_LIMIT_BYPASS_IPS=

# ── Optional: strict CSP for styles ───────────────────────────────────────────
# When set to `true`, `proxy.ts` switches `style-src` to nonce-based CSP
# (removes 'unsafe-inline'). Roll this out behind Content-Security-Policy-Report-Only
# first — some Next.js features still emit inline styles.
# CSP_STRICT_STYLES=false

# ── Optional: trusted proxy hops ──────────────────────────────────────────────
# Number of reverse-proxy layers in front of the app. `1` means the rightmost
# IP in `x-forwarded-for` is trusted. Leave unset when you terminate TLS directly.
#
# IMPORTANT for rate limiting: in production, when neither a trusted
# `x-forwarded-for` (this variable) nor `x-real-ip` identifies the client,
# rate limiting is SKIPPED (with a one-time warning) rather than collapsing
# every visitor into one shared bucket — set this correctly for your
# platform (Vercel: 1) or limits silently don't apply.
# TRUSTED_PROXY_HOPS=1
#
# `x-real-ip` is accepted as a fallback identity ONLY when this is set (> 0):
# without a declared proxy the header is client-controlled and ignored.

# ── Optional: Web Vitals beacon ───────────────────────────────────────────────
# Endpoint that receives beacons from `src/components/layouts/WebVitals.tsx`.
# NEXT_PUBLIC_VITALS_ENDPOINT=

# ── Optional: on-demand ISR webhook ──────────────────────────────────────────
# Shared secret for POST /api/revalidate (CMS/backend publish hooks), sent
# ONLY as the `x-revalidate-secret` header. Unset → the endpoint answers 501
# and cannot be abused. Min 16 chars.
# REVALIDATE_SECRET=

# ── Optional: search indexing ─────────────────────────────────────────────────
# Only the real production deploy is indexable (robots allow + sitemap). Vercel
# previews are excluded automatically (VERCEL_ENV); a self-hosted staging sets:
# INDEXING=off
